# Codex CLI state (config, history, sqlite, logs, memories)
.codex/*

# Revula / tool state — rebuilt by scripts/revula_restore.sh
.revula/
tools/
revula/deps/
ghidra-headless-mcp/deps/

# Tool run-state caches
.quark-engine/
.semgrep/
.envi/
.android/

# Logs & scratch
*.log
.mimo2codex/
.opencode/

# Editor / OS
.idea/
.DS_Store

# Environment symlinks into /system and /home/zeus (never commit)
.cursor-server
.vscode-server
.windsurf-server
.vscode/
.lightning_studio/

# Embedded git repos (managed separately; contain their own .gitignore)
revula/
ghidra-headless-mcp/

# Revula MCP runtime scratch (created under studio root by sandbox allowed_dirs)
revula_decompile_*/
revula_smali_*/
revula_quark_*/
revula_*/

# jadx-mcp-server (embedded repo, managed separately)
jadx-mcp-server/
.java/

# Track the restore skill; keep the rest of .codex ignored
!.codex/skills/
.codex/skills/*
!.codex/skills/rev-mcp-restore/
.codex/skills/rev-mcp-restore/*
!.codex/skills/rev-mcp-restore/SKILL.md
!.codex/skills/rev-mcp-restore/agents/
.codex/skills/rev-mcp-restore/agents/*
!.codex/skills/rev-mcp-restore/agents/openai.yaml
